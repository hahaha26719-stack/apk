# Ohr Temimim server production configuration.
# Copy to ../.env and edit. install.sh does this for you and generates SECRET_KEY.

# Secret used to sign admin sessions & tokens. MUST be long and random in production.
SECRET_KEY=change-me-to-a-long-random-string

# Server port (keep 8000).
PORT=8000

# First-run admin account (used only if no admins exist yet). CHANGE THESE.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-password

# Database. Default is a SQLite file in the server directory.
# For PostgreSQL, e.g.: postgresql+psycopg2://user:pass@localhost/ohr_temimim
# DATABASE_URL=sqlite:////opt/ohr-temimim/server/ohr_temimim.db
